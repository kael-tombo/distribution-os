# Distribution OS — environment variables
#
# This file is the canonical, up-to-date list of every variable the
# application reads. Copy it to `.dev.vars` (for local development
# via the Cloudflare Vite plugin) or set them via `wrangler secret put`
# / `wrangler vars` for production.
#
# Lines starting with `#` are comments. Lines of the form `KEY=value`
# are read verbatim by the Workers runtime — do NOT wrap values in
# quotes unless the value itself contains a `#` or newline.
#
# ---------------------------------------------------------------------
# SECRETS  — store via `wrangler secret put <NAME>` (production) or in
#            `.dev.vars` (local, gitignored). NEVER commit real values.
# ---------------------------------------------------------------------

# OpenAI API key used by `POST /api/mission` to call the Responses API
# in live mode. When unset, missions are generated with a deterministic
# demo payload and persisted with `mode: "simulation"`.
OPENAI_API_KEY=

# Stripe webhook signing secret (`whsec_...`) used by
# `POST /api/webhooks/[provider]` to verify HMAC-SHA256 signatures.
# When unset, the webhook receiver returns HTTP 503.
STRIPE_WEBHOOK_SECRET=

# Resend sending-only API key and webhook signing secret. The adapter remains
# disabled unless every Resend variable below is configured.
RESEND_API_KEY=
RESEND_WEBHOOK_SECRET=

# ---------------------------------------------------------------------
# NON-SECRET VARS  — set via `wrangler.toml` `[vars]` (production) or
#                   `.dev.vars` (local). Safe to commit.
# ---------------------------------------------------------------------

# Override the OpenAI Responses API model used by `POST /api/mission`.
# Default: gpt-5.6
OPENAI_MODEL=gpt-5.6

# Optional strategy planning only (never production or publishing). Both this
# explicit opt-in and the exact workspace ID are required to use the shared key.
# Limits: 3 attempts/job, 10 planning attempts/workspace per rolling 24 hours,
# 60-second provider timeout and 4,000 maximum output tokens per AI request.
CAMPAIGN_AI_PLANNING_ENABLED=0
CAMPAIGN_AI_WORKSPACE_ID=

# Exact workspace allowed to use the site-level Resend credential. This makes
# the first adapter intentionally single-tenant until per-workspace secret
# storage exists.
RESEND_WORKSPACE_ID=

# Exact sender stored in and checked against every approved payload.
RESEND_FROM_EMAIL=

# Comma-separated sandbox recipient allowlist. An empty list blocks all sends.
RESEND_ALLOWED_RECIPIENTS=

# ---------------------------------------------------------------------
# BINDINGS  — configured in `wrangler.toml` (production) or
#             `vite.config.ts` (local, read from .openai/hosting.json).
#             Not environment variables in the usual sense; included
#             here for documentation completeness.
# ---------------------------------------------------------------------
#
# DB        D1 binding name. The Cloudflare D1 database backing all
#           27 physical tables. Read by `db/index.ts` via
#           `getDb()` / `getRawDb()`. Default binding name: "DB"
#           (see .openai/hosting.json).
#
# ASSETS    R2 binding name (optional). Reserved for future large-asset
#           storage. Not currently used.
#
# IMAGES    Cloudflare Images binding (provided by the runtime). Used
#           by `worker/index.ts` for image optimisation at
#           `/_vinext/image`.
